{
  "model": "opus[1m]",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "tui": "fullscreen",
  "theme": "dark",
  "permissions": {
    "allow": [
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx next *)",
      "Bash(echo \"tsc-exit:$?\")"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(**/.env*)"
    ],
    "blockReadsOutsideWorkingDirectories": false
  }
}
