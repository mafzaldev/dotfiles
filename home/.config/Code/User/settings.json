{
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "editor.bracketPairColorization.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Symbols Nerd Font Mono', monospace",
  "debug.console.fontFamily": "JetBrains Mono",
  "explorer.confirmDelete": false,
  "workbench.startupEditor": "none",
  "emmet.includeLanguages": {
    "javascriptreact": "javascriptreact",
    "javascript": "html",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.associations": {
    "*.jsx": "javascriptreact",
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnType": true,
  },
  "editor.formatOnSave": true,
  "security.workspace.trust.untrustedFiles": "open",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "editor.linkedEditing": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "explorer.confirmDragAndDrop": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css",
  },
  "editor.quickSuggestions": {
    "strings": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.stickyScroll.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "dart": true,
    "javascript": true,
    "python": true,
    "typescriptreact": true,
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
    },
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.codeActionsOnSave": {},
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": ".flutter-plugins, .packages, .dart_tool, .flutter-plugins-dependencies, .metadata, .packages, pubspec.lock, build.yaml, analysis_options.yaml, all_lint_rules.yaml",
    ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*",
    "package.json": ".browserslist*, .circleci*, .commitlint*, .cz-config.js, .czrc, .dlint.json, .dprint.json, .editorconfig, .eslint*, .firebase*, .flowconfig, .github*, .gitlab*, .gitpod*, .huskyrc*, .jslint*, .lintstagedrc*, .markdownlint*, .node-version, .nodemon*, .npm*, .nvmrc, .pm2*, .pnp.*, .pnpm*, .prettier*, .releaserc*, .sentry*, .simple-git-hooks*, .stackblitz*, .styleci*, .stylelint*, .tazerc*, .textlint*, .tool-versions, .travis*, .versionrc*, .vscode*, .watchman*, .xo-config*, .yamllint*, .yarnrc*, Procfile, apollo.config.*, appveyor*, azure-pipelines*, bower.json, build.config.*, commitlint*, crowdin*, dangerfile*, dlint.json, dprint.json, eslint*, firebase.json, grunt*, gulp*, jenkins*, lerna*, lint-staged*, nest-cli.*, netlify*, nodemon*, npm-shrinkwrap.json, nx.*, package-lock.json, package.nls*.json, phpcs.xml, pm2.*, pnpm*, prettier*, pullapprove*, pyrightconfig.json, release-tasks.sh, release.config.*, renovate*, rollup.config.*, rspack*, simple-git-hooks*, stylelint*, tslint*, tsup.config.*, turbo*, typedoc*, unlighthouse*, vercel*, vetur.config.*, webpack*, workspace.json, xo.config.*, yarn*",
    "readme.*": "authors, backers.md, changelog*, citation*, code_of_conduct.md, codeowners, contributing.md, contributors, copying, credits, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors.md",
  },
  "git.confirmSync": false,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "dart.flutterTestAdditionalArgs": ["--no-sound-null-safety"],
  "breadcrumbs.enabled": false,
  "vsicons.dontShowNewVersionMessage": true,
  "update.showReleaseNotes": false,
  "redhat.telemetry.enabled": false,
  "python.formatting.provider": "none",
  "workbench.editor.empty.hint": "hidden",
  "dart.devToolsLogFile": null,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "git.openRepositoryInParentFolders": "always",
  "dart.lineLength": 100,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
  "vscode-pets.throwBallWithMouse": true,
  "prisma.showPrismaDataPlatformNotification": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "python.createEnvironment.trigger": "off",
  "cursorcord.app.name": "Cursor",
  "css.lint.unknownAtRules": "ignore",
  "workbench.colorTheme": "Atom One Dark",
  "[handlebars]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "prettier.quoteProps": "preserve",
  "prettier.printWidth": 100,
  "cSpell.userWords": ["autoincrement", "Fontisto", "Nephrology", "Pressable", "Pulmonology"],
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.iconTheme": "vscode-icons",
  "chat.mcp.gallery.enabled": true,
  "prisma.hidePrisma6Prompts": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "gitlens.graph.minimap.enabled": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "http.systemCertificatesNode": true,
  "remote.portsAttributes": {
    "3000": {
      "protocol": "http",
    },
  },
  "claudeCode.preferredLocation": "panel",
  "python.terminal.executeInFileDir": true,
  "python.defaultInterpreterPath": "/bin/python3",
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "notebook.output.fontFamily": "monospace",
  "notebook.markup.fontFamily": "monospace",
  "editor.inlayHints.fontFamily": "monospace",
  "terminal.integrated.initialHint": false,
  "chat.viewSessions.orientation": "stacked",
  "extensions.ignoreRecommendations": true,
  "workbench.sideBar.location": "right",
  "chat.tips.enabled": false,
  "geminicodeassist.project": "strategic-heaven-bfgnf",
  "editor.minimap.renderCharacters": false,
  "color-highlight.markRuler": false,
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": false,
  },
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://openapi.vercel.sh": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://spec.openapis.org/": true,
    "https://turborepo.com": true,
    "https://www.schemastore.org/": true,
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "network.meteredConnection": "off",
}
