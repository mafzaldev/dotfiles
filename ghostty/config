# --- Appearance ---
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = JetBrains Mono
font-size = 12
adjust-cell-height = 8%
background-opacity = 0.95
window-theme = ghostty
gtk-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-width = 100
window-height = 30
unfocused-split-opacity = 0.85
resize-overlay = never
font-feature = calt
font-feature = liga

# --- Cursor & mouse ---
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
app-notifications = no-clipboard-copy

# --- Behavior ---
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
confirm-close-surface = false
scrollback-limit = 50000000
bell-features = attention,title

# --- Splits: create, move, zoom ---
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom

# --- Splits: resize & balance ---
keybind = ctrl+shift+alt+left=resize_split:left,40
keybind = ctrl+shift+alt+right=resize_split:right,40
keybind = ctrl+shift+alt+up=resize_split:up,20
keybind = ctrl+shift+alt+down=resize_split:down,20
keybind = ctrl+shift+e=equalize_splits

# --- Tabs ---
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# --- Readability ---
minimum-contrast = 1.1

# --- Mouse conveniences ---
cursor-click-to-move = true
focus-follows-mouse = true

# --- Handy actions ---
keybind = ctrl+shift+k=clear_screen
keybind = shift+enter=text:\x1b\r
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
keybind = ctrl+shift+h=write_scrollback_file:open

# --- Quick terminal (dropdown, works from any app on GNOME Wayland) ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-autohide = true
